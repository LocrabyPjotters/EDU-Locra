// ==========================================
// LOCRA DATABASE SCHEMA
// Supports: SQLite + PostgreSQL
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Organisatie ──────────────────────────
model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  connectCode     String?  @unique
  licenseKey      String   @unique
  licenseType     String // "education" | "business"
  logoUrl         String?
  faviconUrl      String?
  slogan          String?
  primaryColor    String   @default("#6366f1")
  secondaryColor  String   @default("#8b5cf6")
  accentColor     String   @default("#06b6d4")
  welcomePageHtml String?
  footerText      String?
  systemPrompt    String?
  behaviorPrompt  String?
  aiName          String?
  defaultLanguage String   @default("nl")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  settings          OrgSettings?
  users             User[]
  groups            Group[]
  classes           Class[]
  models            InstalledModel[]
  knowledgeBases    KnowledgeBase[]
  templates         PromptTemplate[]
  apiKeys           ApiKey[]
  auditLogs         AuditLog[]
  ollamaNodes       OllamaNode[]
  locraNodes        LocraNode[]
  assignments       Assignment[]
  chatLabels        ChatLabel[]
  conversations     Conversation[]
  slimCheckSessions SlimCheckSession[]
  exams             Exam[]
}

// ── Organisatie Instellingen ─────────────
model OrgSettings {
  id    String       @id @default(cuid())
  orgId String       @unique
  org   Organization @relation(fields: [orgId], references: [id])

  // Licenties & Premium Features
  licenseTier       String    @default("free") // "free" | "edu-basic" | "edu-plus" | "enterprise"
  licenseKey        String? // LOCRA-XXXX-XXXX-XXXX
  licenseVerifiedAt DateTime? // Datum van laatste succesvolle key-verificatie

  // Privacy & Opslag
  chatStorageMode      String  @default("server") // "server" | "local" | "hybrid"
  enableAnonymization  Boolean @default(false)
  dataRetentionDays    Int? // null = oneindig
  enableAuditLogging   Boolean @default(false)
  userCanChooseStorage Boolean @default(true)

  // Security & Netwerk
  enableE2EEncryption    Boolean @default(true)
  enableOpenPCC          Boolean @default(false)
  enableNetworkIsolation Boolean @default(true)
  customDomain           String? // Custom domain voor hosting (bv. chat.mijnschool.nl)
  allowedIps             String? // JSON array van IP ranges voor lokaal netwerk
  ipWhitelistEnabled     Boolean @default(false)
  blockedIps             String? // JSON array van geblokkeerde IPs
  enableLocraConnect     Boolean @default(true)
  locraConnectPublicUrl  String?
  enableExamMode         Boolean @default(false)

  // Auth
  enableKennisnet       Boolean @default(false)
  kennisnetClientId     String?
  kennisnetClientSecret String?
  enableLocalAuth       Boolean @default(true)
  enableGuestAccess     Boolean @default(false)
  enable2FA             Boolean @default(false)
  registrationMode      String  @default("admin") // "admin" | "self"

  // Limits
  enableRateLimiting           Boolean @default(true)
  maxPromptsPerDay             Int?
  maxPromptsPerMonth           Int?
  maxThinkingPerDay            Int? // Deep thinking limiet
  maxTokensPerRequest          Int     @default(4096)
  maxConcurrency               Int     @default(6) // Max gelijktijdige streaming LLM verzoeken
  queueTimeoutSec              Int     @default(45) // Timeout in seconden voor wachtrij
  allowTeachersToOverrideQuota Boolean @default(false)
  maxTeacherOverrideQuota      Int? // Maximale limiet die een docent zelf mag instellen voor een klas

  // Credits Systeem
  enableCredits         Boolean @default(false)
  defaultCreditsPerUser Int     @default(100)
  creditResetInterval   String  @default("monthly") // "daily" | "monthly" | "never"

  // Features
  enableSharedChats     Boolean @default(true)
  enableCollabChats     Boolean @default(true)
  enableFeedback        Boolean @default(true)
  enableReporting       Boolean @default(true)
  enableAttachments         Boolean @default(true)
  enableWebSearch           Boolean @default(false)
  enableWebSearchPiiFilter  Boolean @default(true)
  enableThinkingMode        Boolean @default(true)
  enableDeepResearch        Boolean @default(true)
  enableAPI                 Boolean @default(false)
  enablePlugins             Boolean @default(false)
  enableCaching             Boolean @default(false)
  enableAutoUpdate          Boolean @default(true)
  enableTelemetry           Boolean @default(false)
  enablePlagiarismCheck     Boolean @default(false)
  enableWatermark           Boolean @default(true)
  enableLearningGoals       Boolean @default(false)

  // RAG / Kennisbank
  embeddingModel  String @default("llama3") // Model voor document embeddings
  ragChunkSize    Int    @default(250) // Aantal woorden per tekstbrok
  ragChunkOverlap Int    @default(60) // Aantal overlappende woorden
  ragMinScore     Float  @default(0.25) // Minimale cosine similarity score
  ragTopN         Int    @default(5) // Maximaal aantal brokken naar de chat

  // SOMtoday Integratie
  enableSomtoday  Boolean @default(false)
  somtodayBaseUrl String? // bijv. "bonhoeffer-college"

  // Backups
  enableAutoBackup    Boolean @default(false)
  backupIntervalHours Int     @default(24)
  backupRetentionDays Int     @default(30)

  // E-mail (SMTP) instellingen
  smtpHost      String?
  smtpPort      Int?
  smtpUser      String?
  smtpPass      String?
  smtpFromEmail String?

  // API & Cost Management
  apiIntegrationEnabled Boolean @default(false)
  openAiApiKey          String?
  anthropicApiKey       String?
  huggingFaceApiKey     String?
  openRouterApiKey      String?
  geminiApiKey          String?
  currentApiCost        Float   @default(0.0) // Kept track in dollars or euros
  estimatedApiCost      Float   @default(0.0) // Predicted cost by AI

  // Ollama Performance Tuning
  ollamaNumParallel     Int    @default(1) // OLLAMA_NUM_PARALLEL
  ollamaMaxLoadedModels Int    @default(1) // OLLAMA_MAX_LOADED_MODELS
  ollamaKeepAlive       String @default("5m") // OLLAMA_KEEP_ALIVE
  ollamaContextLength   Int    @default(4096) // OLLAMA_CONTEXT_LENGTH (0 = auto)

  // CodeMatch (GitHub & Code Editor)
  enableCodeMatch         Boolean @default(true)
  codeMatchAccessMode     String  @default("all") // "all" | "restricted"
  codeMatchAllowedClasses String? // JSON array van Class IDs
  codeMatchAllowedGroups  String? // JSON array van Group IDs
  codeMatchOrgRequirement String? // Optionele GitHub organisatie-eis
  githubClientId          String? // GitHub OAuth App Client ID
  githubClientSecret      String? // GitHub OAuth App Client Secret

  // Features & Toggles
  imageGenApiKey   String?
  allowStudentCoop Boolean @default(true)
  enableQuizMode   Boolean @default(true)
  enableEssayCoach Boolean @default(true)
  blockedKeywords  String? // JSON array
  activeTimeStart  String? // e.g. "08:00"
  activeTimeEnd    String? // e.g. "17:00"
  activeDays       String? // JSON array, e.g. [1,2,3,4,5] (Ma-Vr)
  orgHelperModel   String? // AI model used for organizing chats, titles, tags, etc.
  // SlimCheck Instellingen
  slimCheckDefaultVisionModel  String?   @default("minicpm-v:8b")
  slimCheckDefaultGradingModel String?   @default("llama3.1:8b")
  slimCheckRetainScansDays     Int?      @default(30)
  slimCheckRetainFeedbackDays  Int?      @default(365)
  slimCheckRetainGradeDays     Int?      // null = 6 jaar / bewaar altijd

  // Docent Modelselectie & Beperking (SlimCheck / Nakijken)
  teacherModelRestriction      Boolean   @default(false)
  teacherAllowedModels         String?   // JSON array van modelnamen (bijv. ["llama3.1:8b", "mistral:7b"])
  teacherAllowedVisionModels   String?   // JSON array van vision modelnamen (bijv. ["minicpm-v:8b", "llava:7b"])
}

// ── Gebruikers ──────────────────────────
model User {
  id                String       @id @default(cuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id])
  email             String
  username          String
  passwordHash      String? // null bij Kennisnet login
  role              String // "superadmin" | "admin" | "teacher" | "student" | "guest"
  displayName       String
  kennisnetId       String? // Entree OIDC subject
  totpSecret        String? // 2FA
  isActive          Boolean      @default(true)
  language          String       @default("nl")
  darkMode          Boolean      @default(false)
  storagePreference String? // user override: "server" | "local"

  // Wachtwoord Reset
  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  // SOMtoday
  somtodayToken        String? // Encrypted access token
  somtodayRefreshToken String? // Encrypted refresh token
  somtodayStudentId    String? // SOMtoday leerling-ID
  somtodayApiUrl       String? // Base API URL returned by SOMtoday

  // GitHub Integration (CodeMatch)
  githubToken    String? // Encrypted access token
  githubUsername String?

  // Custom Quota & Models (User override)
  customQuotaEnabled Boolean @default(false)
  maxPromptsPerDay   Int?
  maxPromptsPerMonth Int?
  allowedModels      String? // JSON array of allowed model IDs

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creditsUsed    Int       @default(0)
  creditsResetAt DateTime?

  // Gamification & Academy
  academyXp       Int     @default(0)
  academyLevel    Int     @default(1)
  academyProgress String? // JSON opslag voor quiz-resultaten en voltooide modules

  groupMemberships   GroupMember[]
  conversations      Conversation[]
  messages           Message[]
  feedback           Feedback[]
  reports            Report[]
  auditLogs          AuditLog[]
  reactions          MessageReaction[]
  teacherAssignments Assignment[]           @relation("TeacherAssignments")
  submissions        AssignmentSubmission[] @relation("StudentSubmissions")
  studentClasses     StudentClass[]         @relation("StudentClasses")
  teacherClasses     TeacherClass[]         @relation("TeacherClasses")
  uploadedMaterials  ClassMaterial[]        @relation("TeacherMaterials")
  slimCheckSessions  SlimCheckSession[]     @relation("TeacherSlimCheckSessions")
  slimCheckScans     SlimCheckScan[]        @relation("StudentSlimCheckScans")
  teacherExams       Exam[]                 @relation("TeacherExams")
  studentExamSubmissions ExamSubmission[]   @relation("StudentExamSubmissions")
  mobileDevices      MobileDevice[]

  @@unique([orgId, email])
  @@unique([orgId, username])
}

// ── Gekoppelde Mobiele Apparaten (iOS & Android) ──
model MobileDevice {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName     String?
  devicePlatform String    // "ios" | "android"
  pushToken      String?
  appVersion     String?   @default("1.0.0")
  pairedAt       DateTime  @default(now())
  lastActiveAt   DateTime  @default(now())
  isActive       Boolean   @default(true)
}

// ── Groepen/Klassen ─────────────────────
model Group {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  name        String
  description String?
  createdAt   DateTime     @default(now())

  members        GroupMember[]
  knowledgeBases KnowledgeBase[]
  assignments    Assignment[]

  @@unique([orgId, name])
}

model GroupMember {
  id      String @id @default(cuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id])
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  role    String @default("member") // "member" | "owner"

  @@unique([groupId, userId])
}

// ── Klassen Systeem ─────────────────────
model Class {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  name        String
  description String?
  createdAt   DateTime     @default(now())

  // Class-specific Quota & Models
  customQuotaEnabled Boolean @default(false)
  maxPromptsPerDay   Int?
  maxPromptsPerMonth Int?
  allowedModels      String? // JSON array of allowed model IDs

  studentMembers    StudentClass[]
  teacherMembers    TeacherClass[]
  assignments       Assignment[]       @relation("ClassAssignments")
  materials         ClassMaterial[]
  slimCheckSessions SlimCheckSession[]
  exams             Exam[]

  @@unique([orgId, name])
}

model StudentClass {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId String
  student   User     @relation("StudentClasses", fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([classId, studentId])
}

model TeacherClass {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User     @relation("TeacherClasses", fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([classId, teacherId])
}

// ── Gesprekken & Berichten ──────────────
model Conversation {
  id         String        @id @default(cuid())
  orgId      String? // nullable for backward compat; backfilled via migration
  org        Organization? @relation(fields: [orgId], references: [id])
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  title      String        @default("Nieuw gesprek")
  folder     String?
  tags          String? // JSON array
  summary       String? // Rolling short chat summary
  isCustomTitle Boolean @default(false)
  isShared      Boolean @default(false)
  shareToken String?       @unique
  isCollab   Boolean       @default(false)
  modelId    String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  messages     Message[]
  participants ConversationParticipant[]
  labels       ConversationLabel[]

  @@index([orgId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  role           String       @default("participant") // "owner" | "participant"

  @@unique([conversationId, userId])
}

model Message {
  id               String       @id @default(cuid())
  conversationId   String
  conversation     Conversation @relation(fields: [conversationId], references: [id])
  userId           String?
  user             User?        @relation(fields: [userId], references: [id])
  role             String // "user" | "assistant" | "system"
  content          String
  contentEncrypted String? // E2E encrypted variant
  modelUsed        String?
  tokensUsed       Int?
  responseTimeMs   Int?
  watermarkKey     String? // Watermark verificatie
  attachments      String? // JSON array van attachment URLs
  createdAt        DateTime     @default(now())

  feedback  Feedback[]
  reports   Report[]
  reactions MessageReaction[]
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
}

// ── AI Modellen ─────────────────────────
model InstalledModel {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id])
  ollamaName      String // model id/name for the provider (e.g. llama3.1:8b or gpt-4)
  provider        String       @default("ollama") // "ollama" | "openrouter" | "openai" | "anthropic" | "gemini"
  displayName     String // bv. "Llama 3.1 8B"
  description     String?
  size            BigInt? // bytes
  quantization    String? // bv. "Q4_K_M"
  isActive        Boolean      @default(true)
  isDefault       Boolean      @default(false)
  isCodeMatchOnly Boolean      @default(false) // If true, only available in CodeMatch
  routingTier     String       @default("standard") // "light" | "standard" | "heavy"

  creditCost         Int     @default(1)
  thinkingCreditCost Int     @default(3)
  maxConcurrent      Int     @default(2)
  serverNode         String? // voor multi-server
  version            String?
  previousVersions   String? // JSON array voor rollback

  // Toegangsbeheer per model
  accessMode      String  @default("all") // "all" | "teachers-only" | "restricted"
  allowedClassIds String? // JSON array van class IDs die dit model mogen gebruiken
  allowedGroupIds String? // JSON array van group IDs die dit model mogen gebruiken
  teacherOnly     Boolean @default(false) // Alleen docenten/admins

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, ollamaName])
}

// ── Kennisbank (RAG) ────────────────────
model KnowledgeBase {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  groupId      String?
  group        Group?       @relation(fields: [groupId], references: [id])
  name         String
  description  String?
  isActive     Boolean      @default(true)
  allowedRoles String?      @default("[\"admin\", \"teacher\", \"student\"]") // JSON array of allowed roles
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  documents Document[]
}

model Document {
  id              String          @id @default(cuid())
  knowledgeBase   KnowledgeBase   @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  knowledgeBaseId String
  filename        String
  filePath        String
  fileType        String
  fileSize        Int
  status          String          @default("processing") // processing, active, error
  chunks          DocumentChunk[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model DocumentChunk {
  id              String   @id @default(cuid())
  knowledgeBaseId String
  documentId      String
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content         String
  embedding       String // Stored as JSON array of floats: "[0.123, -0.456, ...]"
  chunkIndex      Int
}

// ── Prompt Templates ────────────────────
model PromptTemplate {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  name        String
  description String?
  prompt      String
  category    String?
  icon        String?
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
}

// ── Feedback & Reports ──────────────────
model Feedback {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    String // "up" | "down"
  reason    String?
  createdAt DateTime @default(now())
}

model Report {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  reason    String
  status    String   @default("open") // "open" | "reviewed" | "resolved"
  createdAt DateTime @default(now())
}

// ── API Keys ────────────────────────────
model ApiKey {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id])
  name       String
  keyHash    String       @unique
  prefix     String // eerste 8 chars voor identificatie
  scopes     String? // JSON array: ["chat", "models", "users"]
  isActive   Boolean      @default(true)
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime?
}

// ── Audit Log ───────────────────────────
model AuditLog {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  action    String // bv. "user.login", "model.download", "chat.create"
  category  String       @default("system") // auth, user, settings, model, data, class, security, system
  severity  String       @default("info") // info, warning, critical
  details   String? // JSON
  ipAddress String?
  createdAt DateTime     @default(now())

  @@index([orgId, createdAt])
  @@index([orgId, category])
  @@index([orgId, severity])
  @@index([orgId, action])
}

// ── Opdrachten (Assignments) ────────────
model Assignment {
  id               String       @id @default(cuid())
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id])
  teacherId        String
  teacher          User         @relation("TeacherAssignments", fields: [teacherId], references: [id])
  title            String
  description      String
  instructions     String // Specifieke instructies voor de AI (bv. "Help de leerling maar geef NIET het antwoord")
  aiRules          String? // Extra AI gedragsregels
  subject          String? // Vakgebied: "wiskunde", "nederlands", etc.
  dueDate          DateTime?
  maxAttempts      Int          @default(0) // 0 = onbeperkt
  isActive         Boolean      @default(true)
  allowAttachments Boolean      @default(true)
  modelOverride    String? // Optioneel: forceer een specifiek model voor deze opdracht
  groupId          String? // Optioneel: alleen voor specifieke klas/groep
  group            Group?       @relation(fields: [groupId], references: [id])
  classId          String? // Gekoppeld aan het nieuwe klassensysteem
  class            Class?       @relation("ClassAssignments", fields: [classId], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  submissions       AssignmentSubmission[]
  slimCheckSessions SlimCheckSession[]
}

model AssignmentSubmission {
  id             String     @id @default(cuid())
  assignmentId   String
  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId      String
  student        User       @relation("StudentSubmissions", fields: [studentId], references: [id])
  conversationId String? // Link naar het gesprek waarin de leerling met AI werkte
  status         String     @default("in_progress") // "in_progress" | "submitted" | "reviewed"
  teacherNotes   String? // Docent feedback
  grade          String? // Beoordeling
  googleDocUrl   String? // Link naar de Google Doc (Bring Your Own Link)
  aiGradeReport  String? // Automatisch gegenereerd AI rapport
  messageCount   Int        @default(0)
  startedAt      DateTime   @default(now())
  submittedAt    DateTime?
  reviewedAt     DateTime?
}

// ── Chat Labels ─────────────────────────
model ChatLabel {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  name      String // "Wiskunde", "Nederlands", "Biologie", etc.
  color     String       @default("#6366f1") // Hex kleur
  icon      String? // Emoji of icon naam
  createdAt DateTime     @default(now())

  conversations ConversationLabel[]

  @@unique([orgId, name])
}

model ConversationLabel {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  labelId        String
  label          ChatLabel    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@unique([conversationId, labelId])
}

// ── Vastgepinde Berichten ────────────────
model PinnedMessage {
  id        String   @id @default(cuid())
  messageId String
  userId    String // Wie heeft het vastgepind
  note      String? // Optionele notitie
  createdAt DateTime @default(now())

  @@unique([messageId, userId])
}

// ── Quick Action Cards ──────────────────
model QuickActionCard {
  id          String   @id @default(cuid())
  orgId       String
  title       String
  description String?
  prompt      String // De prompt die wordt ingevuld
  icon        String   @default("💡")
  color       String   @default("#6366f1")
  category    String? // "huiswerk", "samenvatten", "brainstorm", etc.
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Lesmateriaal (Google Classroom stijl) ────
model ClassMaterial {
  id          String   @id @default(cuid())
  classId     String
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  title       String
  description String?
  filename    String
  fileUrl     String // Lokale pad naar bestand (bv. uploads/materials/cuid/file.pdf)
  fileSize    Int      @default(0) // Bytes
  mimeType    String?
  teacherId   String
  teacher     User     @relation("TeacherMaterials", fields: [teacherId], references: [id])
  createdAt   DateTime @default(now())

  @@index([classId])
  @@index([teacherId])
}

// ── Server Federation & Load Balancing ──
model OllamaNode {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  url       String // e.g. "http://192.168.1.100:11434/api"
  isActive  Boolean      @default(true)
  priority  Int          @default(1)
  createdAt DateTime     @default(now())

  @@unique([orgId, url])
}

model LocraNode {
  id        String       @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String // e.g. "Stedelijk Gymnasium Locra"
  url       String // e.g. "https://locra.andere-school.nl"
  apiKey    String // Secret key for authentication
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())

  @@unique([orgId, url])
}

// ── SlimCheck (AI Nakijken) ─────────────────
model SlimCheckSession {
  id             String       @id @default(cuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id])
  teacherId      String
  teacher        User         @relation("TeacherSlimCheckSessions", fields: [teacherId], references: [id])
  assignmentId   String?
  assignment     Assignment?  @relation(fields: [assignmentId], references: [id])
  classId        String?
  class          Class?       @relation(fields: [classId], references: [id])
  title          String
  subject        String? // "wiskunde" | "scheikunde" | etc.
  isMultimodal   Boolean      @default(false) // true = uitsnede meesturen aan nakijk-LLM
  visionModelId  String? // Ollama model voor OCR
  gradingModelId String? // Ollama model voor nakijken
  status         String       @default("draft") // draft|uploading|redacting|processing|review|done
  redactionRect  String? // JSON: {x,y,w,h} als % van pagina of absolute pixels
  layoutZone     String? // JSON: { dividerX: number } - scheiding tussen vraagkolom en antwoordkolom
  totalMaxScore  Int          @default(0)
  // Terugkoppeling instellingen
  returnGrade    Boolean      @default(true)
  returnFeedback Boolean      @default(false)
  returnScan     Boolean      @default(false)
  // Bewaartermijnen (dagen, null = nooit)
  retainScans    Int?         @default(30)
  retainFeedback Int?         @default(365)
  retainGrade    Int? // null = bewaar altijd (of 6*365)
  originalPdfPath String?
  originalPdfName String?
  assignmentPdfPath String?
  assignmentPdfName String?
  rubricPdfPath     String?
  rubricPdfName     String?
  pageCount       Int          @default(0)
  returnModelAnswer Boolean    @default(false)
  isPublished     Boolean      @default(false)
  publishedAt     DateTime?
  // Inplanning & Wachtrij (Off-Hours / Daluren)
  scheduledMode  String?      @default("immediate") // "immediate" | "offpeak_24h" | "offpeak_7d"
  scheduledFor   DateTime?    // Gepland tijdstip voor automatische start
  queuedAt       DateTime?    // Tijdstip van plaatsing in wachtrij
  queuePriority  Int          @default(2) // 1 = Direct/Hoge prioriteit, 2 = 24h daluren, 3 = 7d weekend

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  scans     SlimCheckScan[]
  questions SlimCheckQuestion[]
}

model SlimCheckQuestion {
  id          String              @id @default(cuid())
  sessionId   String
  session     SlimCheckSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  number      Int
  promptText  String? // De vraagstelling / opgave zoals de leerling die ziet
  maxPoints   Float
  modelAnswer String
  notes       String? // Extra AI-instructies
  responses   SlimCheckResponse[]
}

model SlimCheckScan {
  id        String           @id @default(cuid())
  sessionId String
  session   SlimCheckSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String? // Gekoppeld via mapping, pas na verwerking
  student   User?            @relation("StudentSlimCheckScans", fields: [studentId], references: [id])
  anonIndex Int // Volgorde (0, 1, 2, ...) — voor mapping
  startPage Int
  endPage   Int
  pdfPath   String? // Pad naar geredacteerde PDF/pagina's
  status    String           @default("pending") // pending|ocr|grading|done|error
  ocrRaw    String? // JSON
  createdAt DateTime         @default(now())

  responses SlimCheckResponse[]
}

model SlimCheckResponse {
  id            String            @id @default(cuid())
  scanId        String
  scan          SlimCheckScan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  questionId    String
  question      SlimCheckQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  rawText       String?
  cropImagePath String? // Uitsnede van het antwoord
  aiPoints      Float?
  finalPoints   Float? // Door docent aangepast
  aiFeedback    String? // Leerlinggerichte feedback (wordt gepubliceerd)
  aiReasoning   String? // Docentgerichte keuze-toelichting (waarom deze score)
  teacherNote   String?
  confidence    Float? // OCR-zekerheid 0.0–1.0
  needsReview   Boolean           @default(false) // Handmatige beoordeling door docent nodig
  createdAt     DateTime          @default(now())
}

// ── Online Toetsen (Exams) ──────────────
model Exam {
  id                     String       @id @default(cuid())
  orgId                  String
  org                    Organization @relation(fields: [orgId], references: [id])
  teacherId              String
  teacher                User         @relation("TeacherExams", fields: [teacherId], references: [id])
  classId                String?
  class                  Class?       @relation(fields: [classId], references: [id])
  title                  String
  subject                String?
  description            String?
  status                 String       @default("draft") // "draft" | "active" | "closed"
  timeLimitMinutes       Int?         // null = onbeperkt
  accessCode             String?      // Optioneel toegangswachtwoord

  // Beveiliging & Anti-fraude regels
  allowTabSwitch         Boolean      @default(false)
  maxTabSwitchViolations Int          @default(3)
  forceFullscreen        Boolean      @default(false)
  disableCopyPaste       Boolean      @default(true)

  // AI-hulp restrictie
  aiAssistanceMode       String       @default("disabled") // "disabled" | "hints" | "full"
  maxAiHints             Int          @default(3)

  // Vragen en instellingen
  questionsJson          String       // JSON: [{ id, type, question, options, correctAnswer, points, explanation, imageUrl, imageAlt }]
  totalPoints            Int          @default(0)
  passingGrade           Float        @default(5.5)

  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  submissions            ExamSubmission[]

  @@index([orgId, classId])
  @@index([teacherId])
}

model ExamSubmission {
  id                  String    @id @default(cuid())
  examId              String
  exam                Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId           String
  student             User      @relation("StudentExamSubmissions", fields: [studentId], references: [id])
  answersJson         String    @default("{}") // JSON map: { [questionId]: answer }
  tabSwitchViolations Int       @default(0)
  violationLogsJson   String?   @default("[]") // JSON: [{ timestamp, type, details }]
  aiHintsUsed         Int       @default(0)
  status              String    @default("in_progress") // "in_progress" | "submitted" | "graded"
  score               Float?
  maxScore            Float?
  grade               Float?    // Cijfer (1.0 - 10.0)
  teacherNotes        String?
  aiGradingReport     String?
  startedAt           DateTime  @default(now())
  submittedAt         DateTime?
  gradedAt            DateTime?

  @@unique([examId, studentId])
  @@index([examId, status])
}
